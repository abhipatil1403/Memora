# Memora AI Backend Configuration

# Groq Vision API Keys
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY_2 is used by the current extraction service.
GROQ_API_KEY_1=
GROQ_API_KEY_2=your_groq_api_key_here

# Groq Vision Model. This can be changed without editing backend code.
GROQ_MODEL=qwen/qwen3.8-27b

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
