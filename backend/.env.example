# Memora AI Backend Configuration

# Groq Vision API Key (Required for live AI extraction)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Vision Model (Default: qwen/qwen3.6-27b)
GROQ_MODEL=qwen/qwen3.6-27b

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
